# Required
TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token

# Optional safety / runtime settings
APKPATCHER_MAX_APK_MB=20
APKPATCHER_JOB_TIMEOUT=1800
APKPATCHER_WORKERS=1

# Leave empty to allow every Telegram user.
# For a private bot, use comma-separated numeric Telegram user IDs.
APKPATCHER_ALLOWED_USERS=

# Optional working directory.
# APKPATCHER_BOT_WORKDIR=/data/data/com.termux/files/home/apkpatcher-bot-jobs
